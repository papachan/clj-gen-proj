{:deps {:aliases [:frontend :shadow-cljs]}

 :dev-http {8080 "resources/public"}

 :nrepl {:port 8777}

 :builds
 {:app {:target           :browser
        :output-dir       "resources/public/js/compiled"
        :asset-path       "/js/compiled"
        ;; suppress warnings, disable it for your own code analysis
        :compiler-options {:warnings {:undeclared-var false}}

        :modules
        {:main
         {:init-fn com.example.app/init}}

        :devtools
        {:after-load  com.example.app/re-render
         :before-load com.example.app/stop
         :preloads    [day8.re-frame-10x.preload.react-18
                       devtools.preload]}

        :dev
        {:compiler-options {:main            com.example.app
                            :infer-externs   auto
                            :closure-defines {goog.DEBUG                           true
                                              re-frame.trace.trace-enabled?        true
                                              day8.re-frame.tracing.trace-enabled? true}}}

        :release
        {:output-dir       "resources/dist/js/compiled"
         :build-options    {:ns-aliases {day8.re-frame.tracing day8.re-frame.tracing-stubs}}
         :compiler-options {:optimizations :advanced
                            :warnings {:undeclared-var false}}}}}}
